# Copy this file to .env so it's picked up by the docker compose yaml files.
# This template is opinionated for an Enterprise Edition (EE) enabled deployment.
#
# IMPORTANT:
# - `NEXT_PUBLIC_*` variables are read at *build time* by the web image.
#   If you change them, you must rebuild the `web_server` image.
# - Do NOT commit `.env` (it contains secrets). This file is safe to commit.
#
# References:
# - Docs/Tech Reference/EE-FEATURES.md
# - https://docs.onyx.app/deployment/authentication

################################################################################
## CORE
################################################################################
IMAGE_TAG=latest
LOG_LEVEL=info

################################################################################
## ENTERPRISE EDITION (EE)
################################################################################
# Backend EE switch (runtime)
ENABLE_PAID_ENTERPRISE_EDITION_FEATURES=true

# Frontend EE switch (build-time)
NEXT_PUBLIC_ENABLE_PAID_EE_FEATURES=true

################################################################################
## SECURITY / ENCRYPTION (REQUIRED FOR EE CREDENTIAL ENCRYPTION)
################################################################################
# Strongly recommended to set.
# Use a long random secret (32+ bytes). Keep it stable after first deploy.
ENCRYPTION_KEY_SECRET=<CHANGE_ME>

################################################################################
## AUTH (choose one)
################################################################################
# Common values: disabled | basic | google_oauth | oidc | saml
AUTH_TYPE=oidc

# --- OIDC ---
OAUTH_CLIENT_ID=<CHANGE_ME>
OAUTH_CLIENT_SECRET=<CHANGE_ME>
OPENID_CONFIG_URL=<CHANGE_ME>

# --- SAML (if AUTH_TYPE=saml) ---
# SAML_CONF_DIR=<CHANGE_ME>

################################################################################
## QUERY HISTORY (EE)
################################################################################
# normal | anonymized | disabled
ONYX_QUERY_HISTORY_TYPE=normal

################################################################################
## OPTIONAL FRONTEND SETTINGS
################################################################################
# NEXT_PUBLIC_THEME=impactfast
# NEXT_PUBLIC_DO_NOT_USE_TOGGLE_OFF_DANSWER_POWERED=false


